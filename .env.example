# Proveedor del LLM: mock, anthropic o bedrock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Bedrock usa las credenciales de AWS CLI
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Tabla de DynamoDB para registrar los onboardings, vacío guarda en memoria
ONBOARDING_TABLE=
# Langfuse (observabilidad). Vacío desactiva las trazas. Las keys salen de Settings > API Keys del proyecto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) o la URL del self-hosted
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separa las trazas por entorno en Langfuse (local, dev, prod)
LANGFUSE_TRACING_ENVIRONMENT=local
